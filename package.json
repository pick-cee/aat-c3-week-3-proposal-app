{
  "name": "koya-proposal-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run migrate && next dev",
    "build": "next build",
    "prestart": "npm run migrate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:schema": "bash supabase/tests/run.sh",
    "migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts",
    "migrate:check": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts --dry-run",
    "migrate:strict": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts --strict",
    "seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "mammoth": "^1.11.0",
    "next": "^15.5.4",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "^6.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
