# Copy to .env.local and fill in. Never commit the filled-in file —
# .gitignore covers .env*, and secrets in git history count as secrets.
#
# src/lib/env.ts validates all of these at server start and names whichever
# one is missing.

# --- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase ----------------------------------------------------------
# URL and anon key are public by design (they reach the browser, and RLS is
# what protects the data). The service role key is NOT — it bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

SUPABASE_DB_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres

# --- Resend ------------------------------------------------------------
RESEND_API_KEY=re_...
# Must be on a domain verified with Resend, or every send fails with the
# "sending domain is not verified" cause, which no retry can fix.
RESEND_FROM_ADDRESS=proposals@yourdomain.com

# --- Demo safety -------------------------------------------------------
# Defaults to true. ONLY the exact string "false" turns it off, so a typo
# or a missing value cannot be what lets this app email a stranger.
DEMO_MODE=true
# Where every outgoing email actually goes while DEMO_MODE is on. The UI
# still shows the real intended recipient before sending.
DEMO_REDIRECT_EMAIL=you@yourdomain.com

# --- App ---------------------------------------------------------------
# Used to build the share link in the client email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
